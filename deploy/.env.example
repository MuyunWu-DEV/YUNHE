# ============================================================
# YUNHE 部署环境变量（复制为 .env 后编辑，勿提交真实口令）
#   cp .env.example .env
# 数据库口令务必改成强随机值（云上不要用 123456）
# ============================================================

# --- MySQL 根口令（官方镜像要求必填，仅容器内使用）---
MYSQL_ROOT_PASSWORD=change-me-root-pass

# --- 应用专用库账号（initdb/01-init.sql 会创建同名库/账号/授权）---
MYSQL_USER=yunhe
MYSQL_PASSWORD=change-me-yunhe-pass

# --- Hibernate DDL：首次建表用 update；结构稳定后改 validate ---
# DDL_AUTO=update

# --- 首次建管理员（建完立刻改回 false 并删掉密码，防默认凭据驻留）---
# 首次登录系统会用此密码播种 admin，且 must_change_password=true（首登强制改密）
# 步骤：SEED_ADMIN=true + ADMIN_INITIAL_PASSWORD=临时密码 → up → 登录改密 → 两行改回
SEED_ADMIN=false
ADMIN_INITIAL_PASSWORD=
