# ============================================================
# YUNHE 应用运行环境变量模板
#
# 首次部署：install.sh 会把本文件复制为 /opt/yunhe/.env，
#   然后你 vi 编辑其中的 DB_USERNAME / DB_PASSWORD（建库时用的账号口令）
#   Systemd EnvironmentFile 格式：KEY=value，值不要含前导/尾随空格
#   改完 systemctl restart yunhe-app 生效。
# ============================================================

# ---------- JVM / 应用基本 ----------
JAVA_OPTS=-Xms512m -Xmx1024m
SERVER_PORT=8080

# ---------- Spring 数据库连接（应用直接识别，键名勿改）----------
# 数据库 JDBC URL（host/port/库名都在这，改库名同步改下面 DB_NAME 注释说明即可）
DB_URL=jdbc:mysql://127.0.0.1:3306/yunhe?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# 应用连库的账号与口令（此账号须已在 MySQL 中创建并授权 yunhe 库）
DB_USERNAME=yunhe_app
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ---------- Hibernate ----------
# 首次空库需 update 建表；表结构稳定后改 validate 防误改线上结构
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ---------- 首次建管理员（播种一次后请置 false）----------
# 置 true + 填 ADMIN_INITIAL_PASSWORD 启动一次即建出 admin（首登强制改密），建完改回 false 重启
SPRING_APP_SECURITY_SEED_DEFAULT_ADMIN=false
SPRING_APP_SECURITY_ADMIN_INITIAL_PASSWORD=

# ---------- 附：手动建库参考（install.sh 不再代劳，需你在 MySQL root 下执行一次）----------
#   注意：MySQL 8 推荐 caching_sha2_password 认证（Connector/J 8.x 原生支持）。
#         切勿再用 mysql_native_password——新版 MySQL(8.4+)默认已禁用该插件，
#         会导致登录报 ERROR 1524 (Plugin 'mysql_native_password' is not loaded)。
#   CREATE DATABASE IF NOT EXISTS yunhe
#     CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER IF NOT EXISTS 'yunhe_app'@'%'
#     IDENTIFIED WITH caching_sha2_password BY '上面DB_PASSWORD的值';
#   ALTER USER 'yunhe_app'@'%'
#     IDENTIFIED WITH caching_sha2_password BY '上面DB_PASSWORD的值';
#   GRANT ALL PRIVILEGES ON yunhe.* TO 'yunhe_app'@'%';
#   FLUSH PRIVILEGES;
